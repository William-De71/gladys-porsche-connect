{
  "manifest_version": 1,
  "type": "device",
  "name": "Porsche Connect",
  "description": {
    "en": "Your Porsche in Gladys: battery, range, charge, lock, climate, position and scenes.",
    "fr": "Votre Porsche dans Gladys : batterie, autonomie, charge, verrouillage, clim, position, scènes.",
    "de": "Ihr Porsche in Gladys: Batterie, Reichweite, Laden, Verriegelung, Klima, Position, Szenen.",
    "es": "Su Porsche en Gladys: batería, autonomía, carga, cierre, clima, posición y escenas."
  },
  "version": "0.1.1",
  "docker_image": "ghcr.io/william-de71/gladys-porsche-connect:0.1.1",
  "gladys_version": ">=5.2.0",
  "categories": ["energy", "security"],
  "cover_image": "https://raw.githubusercontent.com/William-De71/gladys-porsche-connect/main/cover.jpg",
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "account_intro",
      "type": "section",
      "label": {
        "en": "My Porsche account",
        "fr": "Compte My Porsche",
        "de": "My-Porsche-Konto",
        "es": "Cuenta My Porsche"
      },
      "description": {
        "en": "The account of the My Porsche app, with an active Porsche Connect contract. Porsche sometimes asks for a captcha at the sign-in: the integration then shows it in its dashboard widget, where you type it. Add the widget to a dashboard before saving.",
        "fr": "Le compte de l’app My Porsche, avec un contrat Porsche Connect actif. Porsche demande parfois un captcha à la connexion : l’intégration l’affiche alors dans son widget de tableau de bord, où vous le saisissez. Ajoutez le widget à un tableau de bord avant d’enregistrer.",
        "de": "Das Konto der My-Porsche-App, mit aktivem Porsche-Connect-Vertrag. Porsche verlangt bei der Anmeldung manchmal ein Captcha: Die Integration zeigt es dann in ihrem Dashboard-Widget, wo du es eingibst. Füge das Widget vor dem Speichern einem Dashboard hinzu.",
        "es": "La cuenta de la app My Porsche, con un contrato Porsche Connect activo. Porsche pide a veces un captcha al iniciar sesión: la integración lo muestra entonces en su widget del panel, donde usted lo escribe. Añada el widget a un panel antes de guardar."
      },
      "links": [
        {
          "url": "https://github.com/William-De71/gladys-porsche-connect/blob/main/docs/en.md",
          "label": {
            "en": "Documentation",
            "fr": "Documentation",
            "de": "Dokumentation",
            "es": "Documentación"
          }
        }
      ]
    },
    {
      "key": "email",
      "type": "string",
      "label": {
        "en": "E-mail",
        "fr": "E-mail",
        "de": "E-Mail",
        "es": "Correo electrónico"
      },
      "required": true,
      "placeholder": {
        "en": "name@example.com",
        "fr": "nom@exemple.fr",
        "de": "name@beispiel.de",
        "es": "nombre@ejemplo.es"
      }
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "required": true
    },
    {
      "key": "pin",
      "type": "secret",
      "label": {
        "en": "PIN (4 digits)",
        "fr": "Code PIN (4 chiffres)",
        "de": "PIN (4 Ziffern)",
        "es": "PIN (4 cifras)"
      },
      "description": {
        "en": "The PIN of the My Porsche app. Only needed to unlock the car from Gladys.",
        "fr": "Le code PIN de l’app My Porsche. Utile seulement pour déverrouiller depuis Gladys.",
        "de": "Die PIN der My-Porsche-App. Nur zum Entriegeln aus Gladys nötig.",
        "es": "El PIN de la app My Porsche. Solo hace falta para abrir el coche desde Gladys."
      },
      "required": false
    },
    {
      "key": "options_intro",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      },
      "description": {
        "en": "The integration reads what the car last sent to Porsche: it never wakes the car up. A Porsche sends its data when it parks, while it charges and after a command.",
        "fr": "L’intégration lit ce que la voiture a envoyé en dernier à Porsche : elle ne la réveille jamais. Une Porsche envoie ses données en se garant, pendant la charge et après une commande.",
        "de": "Die Integration liest, was das Fahrzeug zuletzt an Porsche gesendet hat: Sie weckt es nie auf. Ein Porsche sendet seine Daten beim Parken, beim Laden und nach einem Befehl.",
        "es": "La integración lee lo último que el coche envió a Porsche: nunca lo despierta. Un Porsche envía sus datos al aparcar, durante la carga y tras una orden."
      }
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Reading interval",
        "fr": "Intervalle de lecture",
        "de": "Abfrageintervall",
        "es": "Intervalo de lectura"
      },
      "options": [
        {
          "value": "10",
          "label": {
