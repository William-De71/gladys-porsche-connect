  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Signs in to Porsche and lists the cars of the account with the commands they accept.",
        "fr": "Se connecte à Porsche et liste les voitures du compte avec les commandes qu’elles acceptent.",
        "de": "Meldet sich bei Porsche an und listet die Fahrzeuge des Kontos mit ihren Befehlen auf.",
        "es": "Inicia sesión en Porsche y lista los coches de la cuenta con las órdenes que aceptan."
      },
      "timeout_seconds": 60
    },
    {
      "key": "refresh",
      "label": {
        "en": "Read the cars now",
        "fr": "Lire les voitures maintenant",
        "de": "Fahrzeuge jetzt lesen",
        "es": "Leer los coches ahora"
      },
      "description": {
        "en": "Reads every car now, without waiting for the interval.",
        "fr": "Lit chaque voiture maintenant, sans attendre l’intervalle.",
        "de": "Liest jedes Fahrzeug jetzt, ohne das Intervall abzuwarten.",
        "es": "Lee cada coche ahora, sin esperar el intervalo."
      },
      "timeout_seconds": 60
    },
    {
      "key": "diagnostic",
      "label": {
        "en": "Diagnostic",
        "fr": "Diagnostic",
        "de": "Diagnose",
        "es": "Diagnóstico"
      },
      "description": {
        "en": "Writes to the Logs tab what each car reports (measurements, commands), for a report on GitHub or the forum. VIN and position are left out.",
        "fr": "Écrit dans l’onglet Journaux ce que chaque voiture remonte (mesures, commandes), pour un signalement sur GitHub ou le forum. VIN et position sont omis.",
        "de": "Schreibt in den Tab Protokolle, was jedes Fahrzeug meldet (Messwerte, Befehle), für eine Meldung auf GitHub oder im Forum. FIN und Position werden weggelassen.",
        "es": "Escribe en la pestaña Registros lo que cada coche informa (medidas, órdenes), para un informe en GitHub o el foro. VIN y posición se omiten."
      }
    },
    {
      "key": "sign_out",
      "label": {
        "en": "Sign in again",
        "fr": "Se reconnecter",
        "de": "Neu anmelden",
        "es": "Volver a iniciar sesión"
      },
      "description": {
        "en": "Forgets the stored session and signs in again with the e-mail and the password (a captcha may be asked).",
        "fr": "Oublie la session enregistrée et se reconnecte avec l’e-mail et le mot de passe (un captcha peut être demandé).",
        "de": "Verwirft die gespeicherte Sitzung und meldet sich mit E-Mail und Passwort neu an (ein Captcha kann verlangt werden).",
        "es": "Olvida la sesión guardada e inicia sesión de nuevo con el correo y la contraseña (puede pedirse un captcha)."
      },
      "timeout_seconds": 60
    }
  ],
